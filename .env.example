# API Key (Client ID). Buildings and Courses take only this value, as the
# apikey query parameter:
# https://gw.its.yale.edu/soa-gateway/buildings/v2/feed?type=json&apikey=$YALE_API_KEY
YALE_API_KEY=

# Shared Secret (Client Secret). Do not send this on Buildings or Courses
# calls. Those routes are not OAuth. Use it only if a route requires a token.
YALE_API_SECRET=
